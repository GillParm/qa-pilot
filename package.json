{
  "name": "qa-pilot-monorepo",
  "private": true,
  "type": "module",
  "description": "qa-pilot: an AI agent that tests web apps from plain-English instructions, plus a buggy demo shop to try it on.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/qa-pilot"
  ],
  "scripts": {
    "build": "npm run build -w qa-pilot",
    "typecheck": "npm run typecheck -w qa-pilot",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w qa-pilot"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
